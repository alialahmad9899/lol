rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin membership is provisioned manually in Firebase Console.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validProfileFields(data) {
      return data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'locale',
          'interests',
          'primaryGoal',
          'createdAt',
          'updatedAt',
          'schemaVersion'
        ])
        && data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'locale',
          'interests',
          'createdAt',
          'updatedAt',
          'schemaVersion'
        ])
        && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && data.displayName is string
        && data.displayName.size() <= 100
        && data.locale in ['ar', 'en']
        && data.interests is list
        && data.interests.size() <= 20
        && (!('primaryGoal' in data.keys())
          || (data.primaryGoal is string && data.primaryGoal.size() <= 120))
        && data.schemaVersion == 1;
    }

    match /admins/{adminUid} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && validProfileFields(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'locale',
          'interests',
          'primaryGoal',
          'updatedAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.locale in ['ar', 'en']
        && request.resource.data.interests is list
        && request.resource.data.interests.size() <= 20
        && (!('primaryGoal' in request.resource.data.keys())
          || (request.resource.data.primaryGoal is string
            && request.resource.data.primaryGoal.size() <= 120))
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content_items/{contentId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow write: if isAdmin();
    }

    function isProgramPublished(programId) {
      return exists(/databases/$(database)/documents/programs/$(programId))
        && get(/databases/$(database)/documents/programs/$(programId)).data.status == 'published';
    }

    function isFreeProgram(programId) {
      return isProgramPublished(programId)
        && get(/databases/$(database)/documents/programs/$(programId)).data.isFree == true
        && get(/databases/$(database)/documents/programs/$(programId)).data.price == 0;
    }

    function hasActiveProgramEnrollment(userId, programId) {
      return exists(
          /databases/$(database)/documents/users/$(userId)/programEnrollments/$(programId)
        )
        && get(
          /databases/$(database)/documents/users/$(userId)/programEnrollments/$(programId)
        ).data.status == 'active';
    }

    match /programs/{programId} {
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();

      match /days/{dayId} {
        allow get, list: if isAdmin()
          || (
            isSignedIn()
            && isProgramPublished(programId)
            && hasActiveProgramEnrollment(request.auth.uid, programId)
          );
        allow create, update, delete: if isAdmin();
      }
    }

    match /users/{userId}/programEnrollments/{programId} {
      allow get, list: if isOwner(userId) || isAdmin();

      allow create: if isAdmin()
        || (
          isOwner(userId)
          && isFreeProgram(programId)
          && request.resource.data.keys().hasOnly([
            'userId',
            'programId',
            'status',
            'completedDayIds',
            'progressPercent',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'userId',
            'programId',
            'status',
            'completedDayIds',
            'progressPercent',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.programId == programId
          && request.resource.data.status == 'active'
          && request.resource.data.completedDayIds is list
          && request.resource.data.completedDayIds.size() == 0
          && request.resource.data.progressPercent == 0
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
        );

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'completedDayIds',
            'progressPercent',
            'updatedAt'
          ])
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.programId == resource.data.programId
          && request.resource.data.status == resource.data.status
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.completedDayIds is list
          && request.resource.data.completedDayIds.size() <= 365
          && request.resource.data.progressPercent is int
          && request.resource.data.progressPercent >= 0
          && request.resource.data.progressPercent <= 100
          && request.resource.data.updatedAt == request.time
        );

      allow delete: if isAdmin();
    }

    function isCoursePublished(courseId) {
      return exists(/databases/$(database)/documents/courses/$(courseId))
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published';
    }

    function isFreeCourse(courseId) {
      return isCoursePublished(courseId)
        && get(/databases/$(database)/documents/courses/$(courseId)).data.isFree == true
        && get(/databases/$(database)/documents/courses/$(courseId)).data.price == 0;
    }

    function hasActiveCourseEnrollment(userId, courseId) {
      return exists(
          /databases/$(database)/documents/users/$(userId)/enrollments/$(courseId)
        )
        && get(
          /databases/$(database)/documents/users/$(userId)/enrollments/$(courseId)
        ).data.status == 'active';
    }

    match /courses/{courseId} {
      // Published course metadata can be viewed; lesson content is protected below.
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();

      match /lessons/{lessonId} {
        allow get, list: if isAdmin()
          || (
            isSignedIn()
            && isCoursePublished(courseId)
            && hasActiveCourseEnrollment(request.auth.uid, courseId)
          );
        allow create, update, delete: if isAdmin();
      }
    }

    match /users/{userId}/enrollments/{courseId} {
      allow get, list: if isOwner(userId) || isAdmin();

      allow create: if isAdmin()
        || (
          isOwner(userId)
          && isFreeCourse(courseId)
          && request.resource.data.keys().hasOnly([
            'userId',
            'courseId',
            'status',
            'completedLessonIds',
            'progressPercent',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'userId',
            'courseId',
            'status',
            'completedLessonIds',
            'progressPercent',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.courseId == courseId
          && request.resource.data.status == 'active'
          && request.resource.data.completedLessonIds is list
          && request.resource.data.completedLessonIds.size() == 0
          && request.resource.data.progressPercent == 0
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
        );

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'completedLessonIds',
            'progressPercent',
            'updatedAt'
          ])
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.status == resource.data.status
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.completedLessonIds is list
          && request.resource.data.completedLessonIds.size() <= 500
          && request.resource.data.progressPercent is int
          && request.resource.data.progressPercent >= 0
          && request.resource.data.progressPercent <= 100
          && request.resource.data.updatedAt == request.time
        );

      allow delete: if isAdmin();
    }
  }
}
